DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
JWT_SECRET=replace_with_a_long_random_secret
PORT=4000
CORS_ORIGIN=*
# Optional full public storefront URL to encode in the store QR after deployment.
PUBLIC_STORE_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional; set both before running the seed script to create an admin login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
